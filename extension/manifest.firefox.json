{
  "manifest_version": 3,
  "name": "Grabby Downloader",
  "version": "1.1",
  "description": "Send the current video or page to the Grabby app to download.",
  "browser_specific_settings": { "gecko": { "id": "grabby@local", "strict_min_version": "128.0" } },
  "permissions": ["activeTab", "tabs", "webRequest", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "Download with Grabby" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["grabby.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
